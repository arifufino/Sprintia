{
  "name": "sprintia-scrum-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "preview:local": "node scripts/local-preview.mjs",
    "recovery": "node scripts/recovery.mjs",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:release && npm run test:e2e",
    "test:release": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test baseline.spec.ts --update-snapshots=all",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .package-cache"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "mongodb": "6.21.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "mongodb-memory-server-core": "11.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
