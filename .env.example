# Genera este valor con: npm exec auth secret
AUTH_SECRET=

# Cliente OAuth 2.0 tipo "Aplicación web" de Google Cloud
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB Atlas. Nunca publiques una URI real en GitHub.
MONGODB_URI=
MONGODB_DB=sprintia

# IA opcional: si no se configura, Sprintia usa el copiloto local sin enviar datos fuera.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
